---
- name: Install and Configure Nginx
  hosts: webservers
  become: yes

  tasks:

    - name: Update apt packages
      apt:
        update_cache: yes

    - name: Install Nginx
      apt:
        name: nginx
        state: present

    - name: Start and Enable Nginx
      service:
        name: nginx
        state: started
        enabled: yes

    - name: Configure Nginx Web Page
      copy:
        content: |
          <html>
          <head>
            <title>My Nginx Server</title>
          </head>
          <body>
            <h1>Welcome to Nginx Server!</h1>
            <p>Configured using Ansible.</p>
          </body>
          </html>
        dest: /var/www/html/index.html
